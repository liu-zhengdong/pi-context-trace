{
  "name": "pi-context-trace",
  "version": "0.1.3",
  "description": "Local provider context snapshots and a trace viewer for Pi",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "web/index.html",
    "web/style.css",
    "dist",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liu-zhengdong/pi-context-trace.git"
  },
  "homepage": "https://github.com/liu-zhengdong/pi-context-trace#readme",
  "bugs": {
    "url": "https://github.com/liu-zhengdong/pi-context-trace/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:ui": "npm run build && node --test test/ui/*.test.ts",
    "build": "tsc -p tsconfig.build.json && esbuild web/app.ts --bundle --format=esm --target=es2022 --outfile=dist/web/app.js",
    "prepack": "npm run build",
    "test:package": "npm run build && node scripts/test-package.mjs",
    "diagnostics": "biome check . && knip",
    "check": "npm run typecheck && npm test && npm run build && npm run diagnostics",
    "preview": "node test/preview.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "knip": "^5.0.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3"
  }
}
